# Server
PORT=4000
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./uploads
MAX_FILE_MB=12

# Analysis: demo works without external credentials; openai-compatible uses the fields below.
ANALYSIS_PROVIDER=demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional OCR service for scanned PDFs and images.
OCR_SERVICE_URL=http://127.0.0.1:4100/ocr
OCR_TIMEOUT_MS=120000
